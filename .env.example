COPILOT_COST_HOST=0.0.0.0
COPILOT_COST_PORT=8080
COPILOT_COST_DB=./data/copilot-cost.sqlite3
# Hooks send telemetry with NO secret (see docs/SECURITY.md). The collector is
# trusted by its network boundary (IP-restricted/internal ingress). Only set
# COPILOT_COST_INGEST_KEY if you also want optional bearer auth on ingest.
COPILOT_COST_INGEST_KEY=change-me
# GitHub token for collector->GitHub reconcile. Prefer Key Vault + the
# collector's managed identity when deployed:
# COPILOT_COST_KEYVAULT_URL=https://<vault>.vault.azure.net
# COPILOT_COST_KEYVAULT_SECRET=<secret-name>
COPILOT_COST_TELEMETRY_TIMEOUT_SEC=3
COPILOT_COST_LOG_DIR=.copilot/usage
COPILOT_COST_PROMPT_WEIGHT=0.25
COPILOT_COST_TOOL_WEIGHT=0.10
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_TOKEN=
